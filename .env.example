# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────────
DB_USER=pfm
DB_PASSWORD=pfm_secret
DB_NAME=product_feed_manager
DATABASE_URL=postgresql://pfm:pfm_secret@localhost:5432/product_feed_manager

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_products,read_inventory,read_product_listings,read_locations
SHOPIFY_HOST=your-app.ngrok.io

# ─── Media / CDN ───────────────────────────────────────────────────────────────
# Base URL for SKU-based media assets (no trailing slash)
MEDIA_BASE_URL=https://cdn.example.com/media
# TTL for media cache entries (in seconds, default 6 hours)
MEDIA_CACHE_TTL=21600
# Max images to probe per SKU before stopping
MEDIA_MAX_IMAGES=20

# ─── Google OAuth (for Sheets output) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── Encryption (32-char secret for storing tokens) ───────────────────────────
ENCRYPTION_KEY=change_this_to_a_32_char_secret!!

# ─── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONCURRENCY=5
FEED_JOB_TIMEOUT_MS=300000
